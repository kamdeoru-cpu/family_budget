digraph use_case {
    graph [rankdir=LR, fontname="Liberation Sans", bgcolor=white, nodesep=0.18, ranksep=1.0];
    node [fontname="Liberation Sans", fontsize=12];
    edge [color="#616161", arrowhead=none];
    user [label="Пользователь\n(член семьи)", shape=none, fontsize=13];
    subgraph cluster_system {
        label="Приложение «Семейный бюджет»"; style="rounded"; color="#2E7D32"; fontcolor="#1B5E20"; fontsize=14;
        node [shape=ellipse, style=filled, fillcolor="#E8F5E9", color="#2E7D32"];
        uc1 [label="Просмотреть итоги:\nдоходы, расходы, баланс"];
        uc2 [label="Вести журнал операций\n(добавить, изменить, удалить)"];
        uc3 [label="Найти операции\n(фильтр по типу, поиск)"];
        uc4 [label="Вести справочник категорий"];
        uc5 [label="Вести список членов семьи"];
        uc6 [label="Сформировать отчёт\nпо категориям за период"];
        uc7 [label="Сохранить отчёт в CSV"];
        uc8 [label="Проверить введённые данные", fillcolor="#FFF8E1"];
    }
    user -> uc1; user -> uc2; user -> uc3; user -> uc4; user -> uc5; user -> uc6;
    uc6 -> uc7 [style=dashed, arrowhead=vee, label="«extend»", fontsize=10, dir=back];
    uc2 -> uc8 [style=dashed, arrowhead=vee, label="«include»", fontsize=10];
}
